# Optional: real AI answers. Without it, a built-in rule-based assistant is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

PORT=3000
SITE_URL=https://www.dwh.co.uk
SITE_NAME=David Wilson Homes
ASSISTANT_NAME=HomeFinder AI

# Websites allowed to embed the widget (comma separated), or * for any
ALLOWED_ORIGINS=*

# Crawling politeness
CRAWL_DELAY_MS=1000
CRAWL_CONCURRENCY=2
REFRESH_HOURS=24
DETAIL_TTL_HOURS=24

# Free UK place-name lookup (postcodes.io, no key) for "within 10 miles of Leeds"
GEOCODE=on
SHOW_IMAGES=on
