{
  "name": "homefinder-ai",
  "version": "1.0.0",
  "description": "AI chat assistant that reads a new-homes website itself, filters homes from a conversation, and answers every question about each property.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "crawl": "node src/cli/crawl.js",
    "crawl:full": "node src/cli/crawl.js --details --content",
    "test": "vitest run",
    "start:fresh": "node src/cli/crawl.js --content && node src/server.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "p-limit": "^7.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
